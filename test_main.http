}

### Test Case 2: Validation Failure Check (Invalid Email Format)
POST http://127.0.0.1:8000/api/v1/onboarding
Content-Type: application/json

{
  "client": {
    "name": "Bad Email Tester",
    "email": "not-a-valid-email",
    "phone": "555-0000"
  },
  "brief": {
    "business_summary": "Testing Pydantic validation error handling.",
    "target_audience": "Developers",
    "primary_goal": "Trigger a 422 Unprocessable Entity error",
    "required_features": [
      "test"
    ],
    "timeline": "Immediate",
    "budget_range": "$1k-$5k",
    "success_kpis": "Trigger validation failure.",
    "brand_asset_status": "N/A"
  }
}

